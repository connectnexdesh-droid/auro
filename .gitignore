# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment files and secrets
.env
.env.*
!.env.example

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Runtime data: keep directory markers only
data/*
!data/.gitkeep

screenshots/*
!screenshots/.gitkeep

sessions/*
!sessions/.gitkeep

# Test and tooling output
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
playwright-report/
test-results/

# Logs
*.log

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build output
dist/
build/
*.egg-info/
